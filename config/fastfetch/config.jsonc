{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "@HOME@/.config/fastfetch/logo.txt",
    "color": {
      "1": "#dbc84e",
      "2": "#cfc763"
    },
    "padding": {
      "right": 3,
      "top": 3
    }
  },
  "display": {
    "color": {
      "keys": "#dbc84e",
      "title": "#cfc7a2"
    },
    "percent": {
      "color": {
        "green": "#a8d0b6",
        "yellow": "#dbc84e",
        "red": "#ffb4ab"
      }
    },
    "separator": " ",
    "brightColor": false,
    "key": {
      "width": 0
    },
    "size": {
      "ndigits": 2
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#white}╭────────────╮{#}"
    },
    {
      "type": "os",
      "key": "{#white}│ {#magenta}\u001b[1m OS      \u001b[22m{#white} │{#}",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "{#white}│ {#cyan}\u001b[1m Kernel  \u001b[22m{#white} │{#}",
      "format": "{release}"
    },
    {
      "type": "shell",
      "key": "{#white}│ {#white}\u001b[1m$ Shell   \u001b[22m{#white} │{#}",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": "{#white}│ {#blue}\u001b[1m Terminal\u001b[22m{#white} │{#}",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "wm",
      "key": "{#white}│ {#magenta}\u001b[1m WM      \u001b[22m{#white} │{#}",
      "format": "{pretty-name}"
    },
    {
      "type": "cpu",
      "key": "{#white}│ {#blue}\u001b[1m CPU     \u001b[22m{#white} │{#}",
      "format": "{name} @ {freq-max}"
    },
    {
      "type": "gpu",
      "key": "{#white}│ {#magenta}\u001b[1m GPU     \u001b[22m{#white} │{#}",
      "format": "{vendor} {name}",
      "hideType": "integrated"
    },
    {
      "type": "memory",
      "key": "{#white}│ {#blue}\u001b[1m Memory  \u001b[22m{#white} │{#}",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "{#white}│ {#yellow}\u001b[1m OS Age  \u001b[22m{#white} │{#}",
      "format": "{days} days",
      "folders": "/"
    },
    {
      "type": "uptime",
      "key": "{#white}│ {#cyan}\u001b[1m Uptime  \u001b[22m{#white} │{#}",
      "format": "{formatted}"
    },
    {
      "type": "custom",
      "format": "{#white}├────────────┤{#}"
    },
    {
      "type": "custom",
      "key": "{#white}│ {#white}\u001b[1m colors  \u001b[22m{#white} │{#}",
      "format": "{#magenta}● {#cyan}● {#red}● {#blue}● {#magenta}● {#cyan}● {#magenta}● {#blue}● {#yellow}● {#cyan}●{#}"
    },
    {
      "type": "custom",
      "format": "{#white}╰────────────╯{#}"
    }
  ]
}
