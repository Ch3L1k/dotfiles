#!/usr/bin/python3
# Copyright (c) 2026 Ch3L1k. SPDX-License-Identifier: MIT
"""Manual, reversible battery saving for this Intel/Hyprland laptop."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import xml.etree.ElementTree as ET


def command(*args):
    result = subprocess.run(args, text=True, capture_output=True, timeout=20)
    output = result.stdout.strip()
    if result.returncode or output.startswith('error:'):
        raise RuntimeError(result.stderr.strip() or output or str(args))
    return output


def save(path, data):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = path.with_suffix('.tmp')
    with open(temporary, 'w', opener=lambda p, f: os.open(p, f, 0o600)) as stream:
        json.dump(data, stream, ensure_ascii=False, indent=2)
        stream.flush()
        os.fsync(stream.fileno())
    temporary.replace(path)


def cpu_enable(root, state):
    if state.exists():
        return
    turbo = root / 'devices/system/cpu/intel_pstate/no_turbo'
    policies = sorted((root / 'devices/system/cpu/cpufreq').glob('policy[0-9]*'))
    if not turbo.exists() or not policies:
        raise RuntimeError('Поддерживаемый intel_pstate не найден; настройки CPU не изменены.')
    values = {str(turbo.relative_to(root)): turbo.read_text().strip()}
    for policy in policies:
        for name in ('scaling_min_freq', 'scaling_max_freq'):
            p = policy / name
            values[str(p.relative_to(root))] = p.read_text().strip()
    for p in (root / 'class/leds').glob('*kbd_backlight/brightness'):
        values[str(p.relative_to(root))] = p.read_text().strip()
    save(state, values)
    try:
        turbo.write_text('1')
        for policy in policies:
            low, high = policy / 'scaling_min_freq', policy / 'scaling_max_freq'
            cap = min(1800000, int(high.read_text()))
            if int(low.read_text()) > cap:
                low.write_text(str(cap))
            high.write_text(str(cap))
        for relative in values:
            if relative.startswith('class/leds/'):
                (root / relative).write_text('0')
    except BaseException:
        cpu_restore(root, state)
        raise


def cpu_restore(root, state):
    if not state.exists():
        return
    values = json.loads(state.read_text())
    turbo = 'devices/system/cpu/intel_pstate/no_turbo'
    errors = []
    ordered = [turbo] + [k for k in values if k.endswith('/scaling_max_freq')]
    ordered += [k for k in values if k not in ordered]
    for relative in ordered:
        try:
            (root / relative).write_text(values[relative])
        except OSError as error:
            errors.append(f'{relative}: {error}')
    if errors:
        raise RuntimeError('; '.join(errors))
    state.unlink()


def gpu_limits(uuid=None):
    tree = ET.fromstring(command('/usr/bin/nvidia-smi', '-q', '-x'))
    gpu = next(g for g in tree.findall('gpu') if uuid is None or g.findtext('uuid') == uuid)
    return {key: float(gpu.findtext('.//' + name).split()[0]) for key, name in
            [('requested', 'requested_power_limit'), ('current', 'current_power_limit'),
             ('minimum', 'min_power_limit')]} | {'uuid': gpu.findtext('uuid')}


def gpu_restore(state):
    if not state.exists():
        return
    data = json.loads(state.read_text())
    if abs(gpu_limits(data['uuid'])['requested'] - data['limit']) > 0.1:
        command('/usr/bin/nvidia-smi', '-i', data['uuid'], '-pl', str(data['limit']))
        if abs(gpu_limits(data['uuid'])['requested'] - data['limit']) > 0.1:
            raise RuntimeError('NVIDIA не подтвердила восстановление лимита мощности.')
    state.unlink()


def gpu_set_limit(state):
    if state.exists():
        return True
    try:
        limits = gpu_limits()
        target = max(limits['minimum'], min(20.0, limits['current'], limits['requested']))
        if target >= limits['requested']:
            return False
        data = {'uuid': limits['uuid'], 'limit': limits['requested']}
        save(state, data)
        command('/usr/bin/nvidia-smi', '-i', data['uuid'], '-pl', str(target))
        if abs(gpu_limits(data['uuid'])['requested'] - target) > 0.1:
            raise RuntimeError('драйвер не подтвердил новый лимит после команды')
        print(f'NVIDIA: лимит {target:g} Вт.')
        return True
    except Exception as error:
        try:
            gpu_restore(state)
        except Exception as restore_error:
            print(f'NVIDIA: исходный лимит требует повторного восстановления: {restore_error}', file=sys.stderr)
        print(f'NVIDIA: ограничение мощности недоступно: {error}', file=sys.stderr)
        return False


def gpu_enable(state):
    runtime = Path('/sys/bus/pci/devices/0000:01:00.0/power/runtime_status')
    if runtime.exists() and runtime.read_text().strip() == 'active':
        gpu_set_limit(state)


def hardware(action):
    if os.geteuid() != 0:
        raise RuntimeError('Для изменения аппаратных ограничений требуется sudo.')
    directory = Path('/run/battery-eco-root')
    directory.mkdir(mode=0o700, exist_ok=True)
    if directory.is_symlink() or directory.stat().st_uid != 0:
        raise RuntimeError('Небезопасный каталог состояния.')
    with (directory / 'lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        cpu, gpu = directory / 'cpu.json', directory / 'gpu.json'
        if action == 'on':
            cpu_enable(Path('/sys'), cpu)
            gpu_enable(gpu)
        else:
            errors = []
            if gpu.exists():
                try:
                    gpu_restore(gpu)
                except Exception as error:
                    errors.append(str(error))
            try:
                cpu_restore(Path('/sys'), cpu)
            except Exception as error:
                errors.append(str(error))
            if errors:
                raise RuntimeError('; '.join(errors))


def privileged(action):
    # sudo reads the password directly from the user's terminal; it is never logged.
    result = subprocess.run(['sudo', '/usr/bin/python3', str(Path(__file__).resolve()),
                             '_hardware', action])
    if result.returncode:
        raise RuntimeError('Аппаратные настройки не применены/не восстановлены; см. сообщение sudo.')


def lua(value):
    if isinstance(value, bool):
        return 'true' if value else 'false'
    if isinstance(value, dict):
        return '{' + ','.join('[' + lua(k) + ']=' + lua(v) for k, v in value.items()) + '}'
    if isinstance(value, list):
        return '{' + ','.join(lua(v) for v in value) + '}'
    return json.dumps(value, ensure_ascii=False)


def evaluate(code):
    output = command('hyprctl', 'eval', code)
    if output != 'ok':
        raise RuntimeError(output)


def economy_mode(monitor):
    internal = monitor['name'].startswith(('eDP-', 'LVDS-'))
    candidates = []
    for mode in monitor.get('availableModes', []):
        match = re.fullmatch(r'(\d+)x(\d+)@([\d.]+)Hz', mode)
        if not match or (int(match[1]), int(match[2])) != (monitor['width'], monitor['height']):
            continue
        rate = float(match[3])
        if (45 if internal else 50) <= rate <= 60.5 and rate <= monitor['refreshRate'] + 0.1:
            candidates.append((rate, mode.removesuffix('Hz')))
    return min(candidates)[1] if candidates else None


def options():
    names = ['animations:enabled', 'decoration:blur:enabled', 'decoration:shadow:enabled',
             'decoration:active_opacity', 'decoration:inactive_opacity']
    result = {}
    for name in names:
        value = json.loads(command('hyprctl', 'getoption', name, '-j'))
        value = next(value[k] for k in ('bool', 'float', 'int') if k in value)
        node = result
        parts = name.split(':')
        for part in parts[:-1]:
            node = node.setdefault(part, {})
        node[parts[-1]] = value
    return result


def desktop_snapshot():
    monitors = json.loads(command('hyprctl', '-j', 'monitors'))
    backlights = list(Path('/sys/class/backlight').glob('*'))
    return {'signature': os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'),
            'profile': command('powerprofilesctl', 'get'), 'options': options(),
            'monitors': monitors,
            'brightness': {d.name: int((d / 'brightness').read_text()) for d in backlights},
            'active': False}


def restore_desktop(state):
    errors = []
    for name, value in state['brightness'].items():
        try:
            command('brightnessctl', '-d', name, 'set', str(value))
        except Exception as error:
            errors.append(str(error))
    if state['signature'] == os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'):
        try:
            current = {m['name']: m for m in json.loads(command('hyprctl', '-j', 'monitors'))}
        except Exception as error:
            errors.append(str(error))
            current = {}
        for monitor in state['monitors']:
            try:
                active = current.get(monitor['name'])
                if active and active.get('description') == monitor.get('description'):
                    evaluate('hl.monitor(' + lua({
                        'output': monitor['name'],
                        'mode': f"{monitor['width']}x{monitor['height']}@{monitor['refreshRate']:.5f}",
                        'position': f"{monitor['x']}x{monitor['y']}",
                        'scale': monitor['scale'], 'transform': monitor.get('transform', 0),
                    }) + ')')
            except Exception as error:
                errors.append(str(error))
        try:
            evaluate('hl.config(' + lua(state['options']) + ')')
        except Exception as error:
            errors.append(str(error))
    try:
        if command('powerprofilesctl', 'get') != state['profile']:
            command('powerprofilesctl', 'set', state['profile'])
    except Exception as error:
        errors.append(str(error))
    if errors:
        raise RuntimeError('; '.join(errors))


def enable(state_path):
    if state_path.exists():
        state = json.loads(state_path.read_text())
        if not state.get('active'):
            raise RuntimeError('Остался незавершённый запуск; сначала выполните battery-eco off.')
        print('Экономия уже включена; исходный снимок сохранён.')
        return
    state = desktop_snapshot()
    save(state_path, state)
    cpu_active = False
    try:
        if state['profile'] != 'power-saver':
            command('powerprofilesctl', 'set', 'power-saver')
        cpu_active = True
        privileged('on')
        for name, old in state['brightness'].items():
            maximum = int((Path('/sys/class/backlight') / name / 'max_brightness').read_text())
            command('brightnessctl', '-d', name, 'set', str(min(old, max(1, maximum // 4))))
        evaluate('hl.config(' + lua({'animations': {'enabled': False},
                  'decoration': {'blur': {'enabled': False}, 'shadow': {'enabled': False},
                                 'active_opacity': 1.0, 'inactive_opacity': 1.0}}) + ')')
        for monitor in state['monitors']:
            mode = economy_mode(monitor)
            if mode:
                evaluate('hl.monitor(' + lua({'output': monitor['name'], 'mode': mode,
                    'position': f"{monitor['x']}x{monitor['y']}", 'scale': monitor['scale'],
                    'transform': monitor.get('transform', 0)}) + ')')
        errors = command('hyprctl', 'configerrors').strip()
        if errors:
            raise RuntimeError(errors)
        state['active'] = True
        save(state_path, state)
    except BaseException:
        rollback_errors = []
        if cpu_active:
            try:
                privileged('off')
            except Exception as error:
                rollback_errors.append(str(error))
        try:
            restore_desktop(state)
        except Exception as rollback:
            rollback_errors.append(str(rollback))
        if rollback_errors:
            print('Откат не завершён; выполните battery-eco off: ' + '; '.join(rollback_errors), file=sys.stderr)
        else:
            state_path.unlink()
        raise
    print('Экономия включена: CPU до 1,8 ГГц, низкая яркость, эффекты выключены.')


def disable(state_path):
    # Restore hardware even when the desktop session was restarted.
    errors = []
    try:
        privileged('off')
    except Exception as error:
        errors.append(str(error))
    if state_path.exists():
        state = json.loads(state_path.read_text())
        try:
            restore_desktop(state)
        except Exception as error:
            errors.append(str(error))
        if errors:
            state['active'] = False
            save(state_path, state)
    if errors:
        raise RuntimeError('Восстановление завершено не полностью: ' + '; '.join(errors))
    if state_path.exists():
        state_path.unlink()
    print('Экономия выключена; сохранённые параметры восстановлены.')


def status(state_path):
    state = json.loads(state_path.read_text()) if state_path.exists() else None
    mode = ('ВКЛ' if state.get('active') else 'НЕЗАВЕРШЁННОЕ ИЗМЕНЕНИЕ — выполните off') if state else 'ВЫКЛ'
    print('Экономия: ' + mode)
    p = Path('/sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq')
    if p.exists():
        print(f'Предел CPU: {int(p.read_text()) / 1e6:.2f} ГГц')
    p = Path('/sys/devices/system/cpu/intel_pstate/no_turbo')
    if p.exists():
        print('Turbo Boost: ' + ('выключен' if p.read_text().strip() == '1' else 'разрешён'))
    for battery in Path('/sys/class/power_supply').glob('*'):
        if not (battery / 'type').exists() or (battery / 'type').read_text().strip() != 'Battery':
            continue
        print(f"Батарея: {(battery / 'capacity').read_text().strip()}%, {(battery / 'status').read_text().strip()}")
        if (battery / 'current_now').exists() and (battery / 'voltage_now').exists():
            watts = abs(int((battery / 'current_now').read_text()) * int((battery / 'voltage_now').read_text())) / 1e12
            print(f'Мгновенная мощность батареи: {watts:.1f} Вт')


def main():
    if len(sys.argv) == 3 and sys.argv[1] == '_hardware' and sys.argv[2] in ('on', 'off'):
        hardware(sys.argv[2])
        return
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['on', 'off', 'toggle', 'status'], nargs='?', default='status')
    args = parser.parse_args()
    if os.geteuid() == 0:
        raise RuntimeError('Запускайте battery-eco обычным пользователем; sudo будет вызван автоматически.')
    directory = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')) / 'battery-eco'
    directory.mkdir(mode=0o700, exist_ok=True)
    state_path = directory / 'desktop.json'
    with (directory / 'lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        action = ('off' if state_path.exists() else 'on') if args.action == 'toggle' else args.action
        if action == 'on':
            enable(state_path)
        elif action == 'off':
            disable(state_path)
        status(state_path)


if __name__ == '__main__':
    try:
        main()
    except (Exception, KeyboardInterrupt) as error:
        print(f'battery-eco: {error}', file=sys.stderr)
        sys.exit(1)
