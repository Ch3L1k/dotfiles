#!/usr/bin/python3
"""Manual, reversible, unprivileged desktop power saving."""
import argparse
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time

SCHEMA = 2
VISUALS = {'animations:enabled': False, 'decoration:blur:enabled': False,
           'decoration:shadow:enabled': False, 'decoration:active_opacity': 1.0,
           'decoration:inactive_opacity': 1.0}


def runtime():
    return Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))


def session():
    return os.environ.get('HYPRLAND_INSTANCE_SIGNATURE', '')


def state_path():
    return runtime() / 'battery-eco/desktop.json'


def command(*args):
    result = subprocess.run(args, text=True, capture_output=True, timeout=15)
    text = result.stdout.strip()
    if result.returncode or text.lower().startswith('error:'):
        raise RuntimeError(result.stderr.strip() or text or f'Не удалось выполнить {args[0]}')
    return text


def save(state):
    path = state_path()
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = path.with_name(f'.desktop.{os.getpid()}.tmp')
    try:
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'w') as out:
            json.dump(state, out, ensure_ascii=False, indent=2)
            out.flush()
            os.fsync(out.fileno())
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


@contextmanager
def mutation_lock():
    path = runtime() / 'display-power.lock'
    inherited = os.environ.get('DISPLAY_POWER_LOCK_FD')
    if inherited is not None:
        try:
            fd = int(inherited)
            a, b = os.fstat(fd), path.stat()
            if (a.st_dev, a.st_ino) != (b.st_dev, b.st_ino):
                raise ValueError('wrong lock file')
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except (ValueError, OSError) as exc:
            raise RuntimeError('Недействительная блокировка переключения экранов.') from exc
        # Ownership belongs to the caller. Never unlock its shared open description.
        yield fd
        return
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RuntimeError('Переключение уже выполняется; дождитесь завершения.') from exc
        yield fd
    finally:
        os.close(fd)


def lua(value):
    if isinstance(value, bool):
        return 'true' if value else 'false'
    if isinstance(value, dict):
        return '{' + ','.join('[' + lua(k) + ']=' + lua(v) for k, v in value.items()) + '}'
    return json.dumps(value, ensure_ascii=False)


def evaluate(code):
    result = command('hyprctl', 'eval', code)
    if result != 'ok':
        raise RuntimeError(result)


def read_profile():
    return command('powerprofilesctl', 'get')


def set_profile(value):
    command('busctl', '--system', '--allow-interactive-authorization=no', 'set-property',
            'net.hadess.PowerProfiles', '/net/hadess/PowerProfiles', 'net.hadess.PowerProfiles',
            'ActiveProfile', 's', value)
    if read_profile() != value:
        raise RuntimeError('Профиль питания не подтвердился.')


def read_visual(name):
    data = json.loads(command('hyprctl', 'getoption', name, '-j'))
    return next(data[k] for k in ('bool', 'float', 'int') if k in data)


def set_visual(name, value):
    parts = name.split(':')
    tree = value
    for part in reversed(parts):
        tree = {part: tree}
    evaluate('hl.config(' + lua(tree) + ')')
    if read_visual(name) != value:
        raise RuntimeError(f'Не применён параметр {name}.')


def brightness_devices():
    result = {}
    for pattern in ('/sys/class/backlight/*', '/sys/class/leds/*kbd_backlight'):
        import glob
        for folder in glob.glob(pattern):
            p = Path(folder)
            try:
                result[p.name] = {'value': int((p / 'brightness').read_text()),
                                  'maximum': int((p / 'max_brightness').read_text()),
                                  'keyboard': 'kbd_backlight' in p.name}
            except (OSError, ValueError):
                continue
    return result


def set_brightness(name, value):
    command('brightnessctl', '-q', '-d', name, 'set', str(value))
    current = brightness_devices().get(name)
    if current is None or current['value'] != value:
        raise RuntimeError(f'Не подтверждена яркость {name}.')


def monitors():
    return json.loads(command('hyprctl', '-j', 'monitors'))


def monitor_key(m):
    return m.get('description', m['name']) + '\0' + m.get('serial', '')


def monitor_value(m):
    return {'width': m['width'], 'height': m['height'], 'refresh': m['refreshRate']}


def same_mode(a, b):
    return a['width'] == b['width'] and a['height'] == b['height'] and abs(a['refresh'] - b['refresh']) < 0.6


def economy_mode(m):
    modes = []
    for text in m.get('availableModes', []):
        match = re.fullmatch(r'(\d+)x(\d+)@([\d.]+)Hz', text)
        if match and (int(match[1]), int(match[2])) == (m['width'], m['height']):
            rate = float(match[3])
            minimum = 45 if m['name'].startswith(('eDP-', 'LVDS-')) else 50
            if minimum <= rate <= 60.5 and rate <= m['refreshRate'] + .1:
                modes.append(rate)
    if not modes:
        return None
    return min(modes) if m['name'].startswith(('eDP-', 'LVDS-')) else min(modes, key=lambda rate: abs(rate - 60))


def set_monitor(m, value):
    # Coordinates and transform always come from the live output, never an old snapshot.
    rule = {'output': m['name'], 'mode': f"{value['width']}x{value['height']}@{value['refresh']:.5f}",
            'position': f"{m['x']}x{m['y']}", 'scale': m['scale'], 'transform': m.get('transform', 0)}
    evaluate('hl.monitor(' + lua(rule) + ')')
    for _ in range(15):
        actual = next((a for a in monitors() if monitor_key(a) == monitor_key(m)), None)
        if actual and same_mode(monitor_value(actual), value):
            return
        time.sleep(.1)
    raise RuntimeError(f"Не подтверждена частота {m['name']}.")


def snapshot():
    if not session():
        raise RuntimeError('Сеанс Hyprland не найден.')
    return {'schema': SCHEMA, 'signature': session(), 'active': False, 'phase': 'starting',
            'original': {'profile': read_profile(),
                         'brightness': {k: v['value'] for k, v in brightness_devices().items()},
                         'visuals': {k: read_visual(k) for k in VISUALS},
                         'monitors': {monitor_key(m): monitor_value(m) for m in monitors()}},
            'applied': {'brightness': {}, 'visuals': {}, 'monitors': {}}, 'errors': []}


def load():
    path = state_path()
    if not path.exists():
        return None
    data = json.loads(path.read_text())
    if data.get('schema') == SCHEMA:
        return data
    # A legacy CPU/GPU transaction cannot safely be discarded from an unprivileged helper.
    raise RuntimeError('Найден снимок старого режима. Требуется проверка его восстановления; файл сохранён.')


def mark(state, section, key, value):
    if section == 'profile':
        state['applied']['profile'] = value
    else:
        state['applied'][section][key] = value
    # Record intent before the write: a command may change its target then fail.
    save(state)


def override_path():
    return state_path().with_name('overrides.lua')


def write_overrides(state):
    options = {}
    for name, value in VISUALS.items():
        node = options
        parts = name.split(':')
        for part in parts[:-1]:
            node = node.setdefault(part, {})
        node[parts[-1]] = value
    modes = {}
    for m in monitors():
        key = monitor_key(m)
        rate = economy_mode(m)
        baseline = state['original']['monitors'].get(key)
        if rate is not None and baseline and (baseline['width'], baseline['height']) == (m['width'], m['height']):
            modes[m['name']] = f"{m['width']}x{m['height']}@{rate:.5f}"
    path = override_path()
    temporary = path.with_name(f'.overrides.{os.getpid()}.tmp')
    try:
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'w') as out:
            out.write('return ' + lua({'signature': state['signature'], 'options': options, 'monitors': modes}) + '\n')
            out.flush()
            os.fsync(out.fileno())
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def restore(state):
    # An interrupted restore must remain recoverable even before the first setter.
    state.update(active=False, phase='restore-pending')
    save(state)
    override_path().unlink(missing_ok=True)
    errors = []
    orig, applied = state['original'], state['applied']
    def release(section, key, label, restore_one):
        try:
            restore_one()
        except Exception as exc:
            errors.append(f'{label}: {exc}')
            return
        # A later retry owns only unfinished fields, even if the user changes an
        # already restored setting back to the value used by economy.
        if section == 'profile':
            del applied['profile']
        else:
            del applied[section][key]
        save(state)

    if 'profile' in applied:
        def profile():
            if read_profile() == applied['profile']:
                set_profile(orig['profile'])
        release('profile', None, 'Профиль', profile)
    devices = brightness_devices()
    for name, value in list(applied['brightness'].items()):
        def brightness():
            if name in devices and devices[name]['value'] == value:
                set_brightness(name, orig['brightness'][name])
        release('brightness', name, name, brightness)
    if state['signature'] == session():
        for name, value in list(applied['visuals'].items()):
            def visual():
                if read_visual(name) == value:
                    set_visual(name, orig['visuals'][name])
            release('visuals', name, name, visual)
        if applied['monitors']:
            try:
                current = {monitor_key(m): m for m in monitors()}
            except Exception as exc:
                errors.append(f'Мониторы: {exc}')
            else:
                for key, value in list(applied['monitors'].items()):
                    monitor = current.get(key)
                    def restore_monitor():
                        if monitor and same_mode(monitor_value(monitor), value):
                            set_monitor(monitor, orig['monitors'][key])
                    release('monitors', key, monitor['name'] if monitor else key, restore_monitor)
    if errors:
        state.update(active=False, phase='restore-pending', errors=errors)
        save(state)
        raise RuntimeError('Восстановление не завершено: ' + '; '.join(errors))
    state_path().unlink(missing_ok=True)


def apply_display(state):
    for name, value in VISUALS.items():
        if read_visual(name) != value:
            mark(state, 'visuals', name, value)
            set_visual(name, value)
    for m in monitors():
        key = monitor_key(m)
        rate = economy_mode(m)
        if rate is None or abs(m['refreshRate'] - rate) < .1:
            continue
        # Newly enabled outputs also get a baseline; old ones keep their first snapshot.
        if key not in state['original']['monitors']:
            state['original']['monitors'][key] = monitor_value(m)
        baseline = state['original']['monitors'][key]
        if (baseline['width'], baseline['height']) != (m['width'], m['height']):
            # A user resolution change is authoritative: do not restore an obsolete resolution.
            continue
        value = monitor_value(m) | {'refresh': rate}
        mark(state, 'monitors', key, value)
        set_monitor(m, value)


def enable():
    old = load()
    if old:
        if not old['active'] or old['signature'] != session():
            raise RuntimeError('Сначала завершите восстановление обычного режима.')
        return
    state = snapshot()
    save(state)
    try:
        if state['original']['profile'] != 'power-saver':
            mark(state, 'profile', None, 'power-saver')
            set_profile('power-saver')
        for name, device in brightness_devices().items():
            if name not in state['original']['brightness']:
                continue
            target = 0 if device['keyboard'] else min(device['value'], max(1, device['maximum'] // 4))
            if target != device['value']:
                mark(state, 'brightness', name, target)
                set_brightness(name, target)
        apply_display(state)
        state.update(active=True, phase='active', errors=[])
        write_overrides(state)
        save(state)
    except BaseException as original:
        try:
            restore(state)
        except Exception as rollback:
            raise RuntimeError(f'{original}; {rollback}') from original
        raise


def disable():
    state = load()
    if state:
        restore(state)
    else:
        override_path().unlink(missing_ok=True)


def remember_layout(state, normal_modes):
    # A manual layout selection establishes the frequency to restore after
    # economy ends. Hyprland may already have applied the economy frequency.
    if not isinstance(normal_modes, dict):
        raise ValueError('Ожидались режимы мониторов по имени выхода.')
    updates = []
    for monitor in monitors():
        name = monitor['name']
        if name not in normal_modes:
            continue
        mode = normal_modes[name]
        if not isinstance(mode, dict):
            raise ValueError(f'Недопустимый режим {name}.')
        width, height, refresh = (mode.get(key) for key in ('width', 'height', 'refresh'))
        if (width, height) != (monitor['width'], monitor['height']):
            # A concurrent resolution change takes precedence.
            continue
        if not isinstance(refresh, (int, float)) or isinstance(refresh, bool) or not 0 < refresh < 10000:
            raise ValueError(f'Недопустимая частота {name}.')
        prefix = f'{width}x{height}@'
        rates = [float(rate.removesuffix('Hz').removeprefix(prefix))
                 for rate in monitor.get('availableModes', []) if rate.startswith(prefix) and rate.endswith('Hz')]
        if not any(abs(rate - refresh) < .6 for rate in rates):
            raise ValueError(f'{name} не подтверждает режим {refresh:g} Гц.')
        updates.append((monitor, {'width': width, 'height': height, 'refresh': refresh}))
    for monitor, mode in updates:
        key = monitor_key(monitor)
        state['original']['monitors'][key] = mode
        rate = economy_mode(monitor)
        live = monitor_value(monitor)
        if rate is not None and abs(live['refresh'] - rate) < .1:
            state['applied']['monitors'][key] = live
    save(state)


def reconcile(normal_modes=None):
    state = load()
    if not state or not state['active'] or state['signature'] != session():
        return
    # This explicit call follows a compositor reload/display-layout transition.
    # Brightness/profile are intentionally left alone, since the user can change them.
    try:
        if normal_modes:
            remember_layout(state, normal_modes)
        apply_display(state)
        write_overrides(state)
        state['errors'] = []
        save(state)
    except Exception as exc:
        state['errors'] = [str(exc)]
        save(state)
        raise


def status():
    result = {'active': False, 'pending': False, 'issues': [], 'profile': None, 'cpu': {}, 'battery': [], 'monitors': []}
    try:
        state = load()
    except Exception as exc:
        state = None
        result['pending'] = True
        result['issues'].append(str(exc))
    if state:
        result['active'] = bool(state.get('active')) and state['signature'] == session()
        result['pending'] = not result['active']
        result['issues'] += state.get('errors', [])
        if state['signature'] != session():
            result['issues'].append('Сеанс Hyprland изменился; параметры старого рабочего стола не будут восстановлены.')
    try:
        result['profile'] = read_profile()
        if result['active'] and result['profile'] != 'power-saver':
            result['issues'].append('Профиль питания изменён вручную.')
    except Exception as exc:
        result['issues'].append(str(exc))
    for policy in Path('/sys/devices/system/cpu/cpufreq').glob('policy[0-9]*'):
        info = {}
        for name in ('scaling_max_freq', 'scaling_min_freq', 'scaling_governor', 'energy_performance_preference'):
            try:
                info[name] = (policy / name).read_text().strip()
            except OSError:
                pass
        result['cpu'][policy.name] = info
    turbo = Path('/sys/devices/system/cpu/intel_pstate/no_turbo')
    result['turbo_allowed'] = turbo.read_text().strip() == '0' if turbo.exists() else None
    for p in Path('/sys/class/power_supply').glob('*'):
        try:
            if (p / 'type').read_text().strip() != 'Battery':
                continue
            b = {'name': p.name, 'capacity': int((p / 'capacity').read_text()), 'status': (p / 'status').read_text().strip()}
            if (p / 'power_now').exists():
                b['watts'] = int((p / 'power_now').read_text()) / 1e6
            elif (p / 'current_now').exists() and (p / 'voltage_now').exists():
                b['watts'] = abs(int((p / 'current_now').read_text()) * int((p / 'voltage_now').read_text())) / 1e12
            result['battery'].append(b)
        except (OSError, ValueError):
            pass
    try:
        current_monitors = monitors()
        result['monitors'] = [{'name': m['name'], 'refresh': m['refreshRate']} for m in current_monitors]
        if state and state['active'] and state['signature'] == session():
            for m in current_monitors:
                target = state['applied']['monitors'].get(monitor_key(m))
                if target and not same_mode(monitor_value(m), target):
                    result['issues'].append(f"Частота или разрешение {m['name']} изменены после включения экономии.")
            for name in state['applied']['visuals']:
                if read_visual(name) != state['applied']['visuals'][name]:
                    result['issues'].append('Эффекты изменены после включения экономии.')
                    break
    except Exception as exc:
        result['issues'].append(str(exc))
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['on', 'off', 'toggle', 'status', 'reconcile'], nargs='?', default='status')
    parser.add_argument('--json', action='store_true')
    parser.add_argument('--normal-modes', type=json.loads, help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.normal_modes is not None and (args.action != 'reconcile' or not isinstance(args.normal_modes, dict)):
        parser.error('--normal-modes требует reconcile и объект JSON')
    if os.geteuid() == 0:
        raise RuntimeError('Этот скрипт запускается обычным пользователем.')
    if args.action != 'status':
        with mutation_lock():
            action = args.action
            if action == 'toggle':
                action = 'off' if state_path().exists() else 'on'
            if action == 'reconcile':
                reconcile(args.normal_modes)
            elif action == 'on':
                enable()
            else:
                disable()
    data = status()
    if args.json:
        print(json.dumps(data, ensure_ascii=False))
    else:
        print('Экономия: ' + ('ВОССТАНОВЛЕНИЕ НЕ ЗАВЕРШЕНО' if data['pending'] else 'ВКЛ' if data['active'] else 'ВЫКЛ'))
        print('Профиль: ' + str(data['profile']))
        if data['cpu']:
            values = list(data['cpu'].values())
            limits = [int(v['scaling_max_freq']) / 1e6 for v in values if 'scaling_max_freq' in v]
            if limits:
                print(f'Разрешённый максимум CPU: {max(limits):.2f} ГГц (не текущая частота)')
            epp = sorted({v['energy_performance_preference'] for v in values if 'energy_performance_preference' in v})
            if epp:
                print('Предпочтение CPU: ' + ', '.join(epp))
        for b in data['battery']:
            phase = b['status']
            caption = {'Charging':'заряжается', 'Discharging':'разряжается', 'Not charging':'не заряжается',
                       'Full':'заряжена', 'Unknown':'состояние неизвестно'}.get(phase, phase)
            print(f"Батарея: {b['capacity']}%, {caption}")
            if 'watts' in b and phase in ('Charging', 'Discharging'):
                print(('Мощность зарядки' if b['status'] == 'Charging' else 'Мощность разряда') + f": {b['watts']:.1f} Вт")
        for issue in data['issues']:
            print('Внимание: ' + issue)


if __name__ == '__main__':
    try:
        main()
    except (Exception, KeyboardInterrupt) as error:
        print(f'battery-eco: {error}', file=sys.stderr)
        sys.exit(1)
