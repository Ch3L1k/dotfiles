#!/usr/bin/python
"""Toggle the external display while preserving this Hyprland session's layout."""
import argparse
import copy
import fcntl
import json
import os
import re
from pathlib import Path
import subprocess
import sys
import time


def command(*args):
    result = subprocess.run(args, text=True, capture_output=True, timeout=10)
    if result.returncode or result.stdout.lstrip().startswith("error:"):
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or str(args))
    return result.stdout


def query(*args):
    return json.loads(command("hyprctl", *args, "-j"))


def lua(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, dict):
        return "{" + ",".join("[" + lua(k) + "]=" + lua(v) for k, v in value.items()) + "}"
    if isinstance(value, list):
        return "{" + ",".join(lua(v) for v in value) + "}"
    return json.dumps(value, ensure_ascii=False)


def evaluate(code):
    response = command("hyprctl", "eval", code).strip()
    if response != "ok":
        raise RuntimeError(response)


def atomic_write(path, text):
    temporary = path.with_suffix(".tmp")
    with temporary.open("w") as stream:
        stream.write(text)
        stream.flush()
        os.fsync(stream.fileno())
    temporary.replace(path)


signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "default")
if "/" in signature:
    raise SystemExit("Invalid Hyprland session identifier")
runtime = Path(os.environ.get("XDG_RUNTIME_DIR", "/run/user/" + str(os.getuid())))
directory = runtime / ("hypr-display-toggle-" + signature)
directory.mkdir(mode=0o700, exist_ok=True)
mode_file = directory / "mode.lua"
snapshot_file = directory / "snapshot.json"


def laptop_mode():
    return mode_file.exists() and mode_file.read_text().startswith("-- laptop_only=true\n")


def external_mode(refresh=None):
    if not mode_file.exists():
        return False
    text = mode_file.read_text()
    if "-- external_only=true\n" not in text:
        return False
    if refresh is None:
        return True
    match = re.search(r"^-- external_refresh=([\d.]+)$", text, re.MULTILINE)
    # Existing session files predate the 120 Hz option and always mean 60 Hz.
    return abs((float(match[1]) if match else 60) - refresh) <= 0.5


def detect(monitors, snapshot=None, allow_missing_external=False):
    internal = next((m for m in monitors if m["name"].startswith(("eDP-", "LVDS-"))), None)
    if not internal:
        raise RuntimeError("Экран ноутбука не найден; переключение отменено.")
    candidates = [m for m in monitors if m["name"] not in (internal["name"], "FALLBACK")]
    if not candidates:
        if allow_missing_external and snapshot:
            return {"name": snapshot["external"]}, internal
        raise RuntimeError("Внешний монитор не найден.")
    old_name = (snapshot or {}).get("external")
    external = max(
        candidates,
        key=lambda m: (
            "MSI MP252" in m.get("description", ""),
            m["name"] == old_name,
            m.get("refreshRate", 0),
        ),
    )
    return external, internal


def external_refresh_mode(monitor, refresh=60, saved_mode=None):
    width, height = monitor.get("width"), monitor.get("height")
    if (monitor.get("disabled") or not width or not height) and saved_mode:
        width, height = map(int, saved_mode.split("@", 1)[0].split("x"))
    modes = []
    for mode in monitor.get("availableModes", []):
        match = re.fullmatch(r"(\d+)x(\d+)@([\d.]+)Hz", mode)
        if match and int(match[1]) == width and int(match[2]) == height:
            hz = float(match[3])
            if abs(hz - refresh) <= 0.5:
                modes.append((abs(hz - refresh), mode.removesuffix("Hz")))
    if not modes:
        raise RuntimeError(f"Основной монитор не сообщает режим {refresh} Гц для текущего разрешения.")
    return min(modes)[1]


external_60_mode = external_refresh_mode  # Historical helper used by the dotfiles regression suite.


def build_state(target, snapshot, external, internal, external_hz=60):
    monitors = {
        external["name"]: copy.deepcopy(snapshot["monitors"][snapshot["external"]]),
        internal["name"]: copy.deepcopy(snapshot["monitors"][snapshot["internal"]]),
    }
    if target == "external":
        monitors[external["name"]].update(mode=external_refresh_mode(external, external_hz, monitors[external["name"]]["mode"]), position="0x0")
    return {"laptop_only": target == "laptop", "external_only": target == "external",
            "external": external["name"], "internal": internal["name"], "monitors": monitors,
            "changed_at": time.monotonic_ns()}


def runtime_visuals():
    result = {}
    for option in ["animations:enabled", "decoration:blur:enabled", "decoration:shadow:enabled",
                   "decoration:active_opacity", "decoration:inactive_opacity"]:
        data = query("getoption", option)
        value = next(data[k] for k in ("bool", "float", "int") if k in data)
        node = result
        parts = option.split(":")
        for name in parts[:-1]:
            node = node.setdefault(name, {})
        node[parts[-1]] = value
    return result


def monitor_settings(monitor):
    return {
        "mode": f'{monitor["width"]}x{monitor["height"]}@{monitor["refreshRate"]:.5f}',
        "position": f'{monitor["x"]}x{monitor["y"]}',
        "scale": monitor["scale"],
        "transform": monitor.get("transform", 0),
    }


def session_data(path):
    if not path.exists():
        return {}
    data = json.loads(path.read_text())
    return data if data.get("signature") == signature else {}


def normal_settings(monitor, eco, manual):
    settings = monitor_settings(monitor)
    width, height = monitor["width"], monitor["height"]
    rate = monitor["refreshRate"]
    key = monitor.get("description", monitor["name"]) + chr(0) + monitor.get("serial", "")
    applied = eco.get("applied", {}).get("monitors", {}).get(key, {})
    original = eco.get("original", {}).get("monitors", {}).get(key, {})
    if ((applied.get("width"), applied.get("height")) == (width, height)
            and (original.get("width"), original.get("height")) == (width, height)
            and abs(applied["refresh"] - rate) < 0.6):
        rate = original["refresh"]
    # The manual override has its own lifetime and is reapplied by monitors.lua.
    if (manual.get("identity") == [monitor.get("description"), monitor.get("serial")]
            and (manual.get("width"), manual.get("height")) == (width, height)
            and abs(rate - 60) < 0.6):
        rate = manual["refresh"]
    settings["mode"] = f"{width}x{height}@{rate:.5f}"
    return settings


def numbered_workspaces():
    for workspace in query("workspaces"):
        # Hyprland also reports special and named workspaces without a numeric ID.
        number = workspace.get("id")
        if isinstance(number, int) and number > 0 and workspace.get("type", "normal") == "normal":
            yield workspace


def capture(external, internal):
    eco = session_data(runtime / "battery-eco/desktop.json")
    manual = session_data(runtime / "main-monitor-rate.json")
    return {
        "external": external["name"],
        "internal": internal["name"],
        "monitors": {m["name"]: normal_settings(m, eco, manual) for m in (external, internal)},
        "active": {
            m["name"]: m.get("activeWorkspace", {}).get("name") or ("9" if m is internal else "1")
            for m in (external, internal)
        },
        "workspaces": [
            {"id": w["id"], "name": w["name"], "monitor": w["monitor"]}
            for w in numbered_workspaces()
        ],
        "focused_workspace": query("activeworkspace")["name"],
    }


def workspace_selector(name):
    return int(name) if str(name).isdigit() else "name:" + str(name)


def focus_workspace(name):
    evaluate("hl.dispatch(hl.dsp.focus({workspace=" + lua(workspace_selector(name)) + "}))")


def apply(target, snapshot, external_hz=60):
    focused_before = query("activeworkspace")["name"] or snapshot["focused_workspace"]
    available = query("monitors", "all")
    external, internal = detect(available, snapshot, allow_missing_external=target != "external")
    external_name, internal_name = external["name"], internal["name"]
    if target == "dual" and not any(m["name"] == external_name for m in available):
        target = "laptop"
    only_laptop = target == "laptop"
    state = build_state(target, snapshot, external, internal, external_hz)
    visuals = runtime_visuals()
    atomic_write(mode_file, "-- laptop_only=" + lua(only_laptop) +
                 "\n-- external_only=" + lua(target == "external") +
                 "\n-- external_refresh=" + str(external_hz) + "\nreturn " + lua(state) + "\n")
    try:
        command("hyprctl", "reload", "config-only")
    finally:
        if not (runtime / "battery-eco/desktop.json").exists():
            evaluate("hl.config(" + lua(visuals) + ")")
    deadline = time.monotonic() + 6
    while time.monotonic() < deadline:
        enabled = [m for m in query("monitors") if not m.get("disabled")]
        active = {m["name"] for m in enabled}
        expected = {internal_name} if only_laptop else ({external_name} if target == "external" else {internal_name, external_name})
        refresh_ok = target != "external" or any(
            m["name"] == external_name and abs(m["refreshRate"] - external_hz) <= 0.6
            for m in enabled)
        if active == expected and refresh_ok:
            break
        time.sleep(0.1)
    else:
        raise RuntimeError("Hyprland не применил режим мониторов.")

    previous = {w["name"]: w["monitor"] for w in snapshot["workspaces"]}
    moves = []
    for workspace in numbered_workspaces():
        name = workspace["name"]
        old_monitor = previous.get(name)
        if only_laptop:
            destination = internal_name
        elif target == "external":
            destination = external_name
        elif old_monitor == snapshot["internal"] or (old_monitor is None and name in ("9", "10")):
            destination = internal_name
        else:
            destination = external_name
        if workspace["monitor"] != destination:
            moves.append("hl.dispatch(hl.dsp.workspace.move({workspace=" +
                         lua(workspace_selector(name)) + ",monitor=" + lua(destination) + "}))")
    if moves:
        evaluate(";".join(moves))
    if target in ("laptop", "external"):
        focus_workspace(focused_before)
        evaluate("hl.dispatch(hl.dsp.focus({monitor=" + lua(internal_name if only_laptop else external_name) + "}))")
    else:
        active = snapshot["active"]
        focus_workspace(active[snapshot["internal"]])
        focus_workspace(active[snapshot["external"]])
        if snapshot["focused_workspace"] != active[snapshot["external"]]:
            focus_workspace(snapshot["focused_workspace"])
    errors = command("hyprctl", "configerrors").strip()
    if errors:
        raise RuntimeError(errors)
    return target


def normal_modes(target, snapshot, external_hz):
    external, internal = detect(query("monitors", "all"), snapshot, allow_missing_external=True)
    manual = session_data(runtime / "main-monitor-rate.json")
    result = {}
    for role, monitor in (("internal", internal), ("external", external)):
        if (role == "internal" and target == "external") or (role == "external" and target == "laptop"):
            continue
        mode = snapshot["monitors"][snapshot[role]]["mode"]
        if role == "external" and target == "external":
            mode = external_refresh_mode(monitor, external_hz, mode)
        elif manual.get("identity") == [monitor.get("description"), monitor.get("serial")]:
            mode = manual["mode"]
        resolution, rate = mode.split("@")
        width, height = map(int, resolution.split("x"))
        result[monitor["name"]] = {"width": width, "height": height, "refresh": float(rate)}
    return result


def notify(text, error=False):
    try:
        subprocess.run(["notify-send", "-a", "Мониторы", "-i", "video-display",
                        "-u", "critical" if error else "normal", "Мониторы", text],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        pass


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--laptop", action="store_true")
    group.add_argument("--restore", action="store_true")
    group.add_argument("--status", action="store_true")
    group.add_argument("--external-60", action="store_true", help="Внешний экран 60 Гц / вернуть прежнюю раскладку")
    group.add_argument("--external-120", action="store_true", help="Только основной монитор 120 Гц / вернуть прежнюю раскладку")
    group.add_argument("--recover-external", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()
    external_hz = 120 if args.external_120 else 60
    if args.status:
        print(json.dumps({"laptop_only": laptop_mode(), "external_only": external_mode(), "monitors": [
            {"name": m["name"], "focused": m["focused"], "refresh": m["refreshRate"]}
            for m in query("monitors")
        ]}))
        return
    with (runtime / "display-power.lock").open("a") as lock:
        try:
            # Recovery is queued behind a transition, never discarded during hot-unplug.
            fcntl.flock(lock, fcntl.LOCK_EX | (0 if args.recover_external else fcntl.LOCK_NB))
        except BlockingIOError:
            raise RuntimeError("Другой режим уже переключается; дождитесь завершения.")
        if args.external_120 and (runtime / "battery-eco/desktop.json").exists():
            raise RuntimeError("Сначала выключите экономию: она управляет частотой экранов.")
        if args.recover_external:
            if not external_mode():
                return
            if any(m["name"] != "FALLBACK" and not m["name"].startswith(("eDP-", "LVDS-")) and not m.get("disabled") for m in query("monitors")):
                return
            target = "laptop"
        elif args.external_60 or args.external_120:
            target = "dual" if external_mode(external_hz) else "external"
        else:
            target = "laptop" if args.laptop or (not args.restore and not laptop_mode()) else "dual"
        single_mode = laptop_mode() or external_mode()
        if target == "dual" and not single_mode:
            return
        if target != "dual" and not single_mode:
            external, internal = detect(query("monitors", "all"))
            if external.get("disabled"):
                raise RuntimeError("Нет активного внешнего монитора для сохранения раскладки.")
            snapshot = capture(external, internal)

        else:
            if not snapshot_file.exists():
                if target == "dual":
                    return
                raise RuntimeError("Нет сохранённой раскладки.")
            snapshot = json.loads(snapshot_file.read_text())
        previous_target = "laptop" if laptop_mode() else "external" if external_mode() else "dual"
        previous_hz = 120 if external_mode(120) else 60
        if target == "dual" and (args.external_60 or args.external_120):
            target = snapshot.get("return_from_external", "dual")
        if target == "external" and previous_target != "external":
            snapshot["return_from_external"] = previous_target
        # Reject unsupported requests before any config reload or rollback.
        if target == "external":
            external, _ = detect(query("monitors", "all"), snapshot)
            external_refresh_mode(external, external_hz, snapshot["monitors"][snapshot["external"]]["mode"])
        if not single_mode or (target == "external" and previous_target != "external"):
            atomic_write(snapshot_file, json.dumps(snapshot, indent=2))
        try:
            target = apply(target, snapshot, external_hz)
        except Exception:
            # Restore the layout the user actually had before the failed switch.
            try:
                apply(previous_target, snapshot, previous_hz)
            except Exception:
                mode_file.unlink(missing_ok=True)
                subprocess.run(["hyprctl", "reload", "config-only"], capture_output=True, timeout=10)
            raise
        if (runtime / "battery-eco/desktop.json").exists():
            env = os.environ.copy()
            env["DISPLAY_POWER_LOCK_FD"] = str(lock.fileno())
            result = subprocess.run([str(Path.home() / ".local/bin/battery-eco"), "reconcile",
                                     "--normal-modes", json.dumps(normal_modes(target, snapshot, external_hz))],
                                    env=env, pass_fds=(lock.fileno(),), capture_output=True, text=True, timeout=30)
            if result.returncode:
                raise RuntimeError(result.stderr.strip() or "Не удалось согласовать экономию и мониторы")
        # XWayland has its own primary output, independent of Hyprland focus.
        try:
            subprocess.run([str(Path.home() / ".local/bin/set-xwayland-primary")],
                           capture_output=True, timeout=8, check=False)
        except (OSError, subprocess.TimeoutExpired):
            pass
        message = {"laptop": "Только экран ноутбука", "external": f"Только основной монитор, {external_hz} Гц", "dual": "Прежняя раскладка мониторов восстановлена"}[target]
        notify(message)
        print(message)


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        notify(str(error), error=True)
        print(str(error), file=sys.stderr)
        sys.exit(1)
