#!/usr/bin/python
"""Toggle the external display while preserving this Hyprland session's layout."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import time


def command(*args):
    result = subprocess.run(args, text=True, capture_output=True, timeout=10)
    if result.returncode or result.stdout.lstrip().startswith("error:"):
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or str(args))
    return result.stdout


def query(*args):
    return json.loads(command("hyprctl", *args, "-j"))


def lua(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, dict):
        return "{" + ",".join("[" + lua(k) + "]=" + lua(v) for k, v in value.items()) + "}"
    if isinstance(value, list):
        return "{" + ",".join(lua(v) for v in value) + "}"
    return json.dumps(value, ensure_ascii=False)


def evaluate(code):
    response = command("hyprctl", "eval", code).strip()
    if response != "ok":
        raise RuntimeError(response)


def atomic_write(path, text):
    temporary = path.with_suffix(".tmp")
    with temporary.open("w") as stream:
        stream.write(text)
        stream.flush()
        os.fsync(stream.fileno())
    temporary.replace(path)


signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "default")
if "/" in signature:
    raise SystemExit("Invalid Hyprland session identifier")
runtime = Path(os.environ.get("XDG_RUNTIME_DIR", "/run/user/" + str(os.getuid())))
directory = runtime / ("hypr-display-toggle-" + signature)
directory.mkdir(mode=0o700, exist_ok=True)
mode_file = directory / "mode.lua"
snapshot_file = directory / "snapshot.json"


def laptop_mode():
    return mode_file.exists() and mode_file.read_text().startswith("-- laptop_only=true\n")


def detect(monitors, snapshot=None):
    internal = next((m for m in monitors if m["name"].startswith(("eDP-", "LVDS-"))), None)
    if not internal:
        raise RuntimeError("Экран ноутбука не найден; переключение отменено.")
    candidates = [m for m in monitors if m["name"] != internal["name"]]
    if not candidates:
        raise RuntimeError("Внешний монитор не найден.")
    old_name = (snapshot or {}).get("external")
    external = max(
        candidates,
        key=lambda m: (
            "MSI MP252" in m.get("description", ""),
            m["name"] == old_name,
            m.get("refreshRate", 0),
        ),
    )
    return external, internal


def monitor_settings(monitor):
    return {
        "mode": f'{monitor["width"]}x{monitor["height"]}@{monitor["refreshRate"]:.5f}',
        "position": f'{monitor["x"]}x{monitor["y"]}',
        "scale": monitor["scale"],
        "transform": monitor.get("transform", 0),
    }


def capture(external, internal):
    return {
        "external": external["name"],
        "internal": internal["name"],
        "monitors": {m["name"]: monitor_settings(m) for m in (external, internal)},
        "active": {
            m["name"]: m["activeWorkspace"]["name"] for m in (external, internal)
        },
        "workspaces": [
            {"id": w["id"], "name": w["name"], "monitor": w["monitor"]}
            for w in query("workspaces") if w["id"] > 0
        ],
        "focused_workspace": query("activeworkspace")["name"],
    }


def workspace_selector(name):
    return int(name) if str(name).isdigit() else "name:" + str(name)


def focus_workspace(name):
    evaluate("hl.dispatch(hl.dsp.focus({workspace=" + lua(workspace_selector(name)) + "}))")


def apply(only_laptop, snapshot):
    external, internal = detect(query("monitors", "all"), snapshot)
    external_name, internal_name = external["name"], internal["name"]
    monitors = {
        external_name: snapshot["monitors"][snapshot["external"]],
        internal_name: snapshot["monitors"][snapshot["internal"]],
    }
    state = {
        "laptop_only": only_laptop,
        "external": external_name,
        "internal": internal_name,
        "monitors": monitors,
    }
    atomic_write(mode_file, "-- laptop_only=" + lua(only_laptop) + "\nreturn " + lua(state) + "\n")
    command("hyprctl", "reload")
    deadline = time.monotonic() + 6
    while time.monotonic() < deadline:
        active = {m["name"] for m in query("monitors") if not m.get("disabled")}
        expected = {internal_name} if only_laptop else {internal_name, external_name}
        if expected <= active and (not only_laptop or external_name not in active):
            break
        time.sleep(0.1)
    else:
        raise RuntimeError("Hyprland не применил режим мониторов.")

    previous = {w["name"]: w["monitor"] for w in snapshot["workspaces"]}
    moves = []
    for workspace in query("workspaces"):
        if workspace["id"] <= 0:
            continue
        name = workspace["name"]
        old_monitor = previous.get(name)
        if only_laptop:
            destination = internal_name
        elif old_monitor == snapshot["internal"] or (old_monitor is None and name in ("9", "10")):
            destination = internal_name
        else:
            destination = external_name
        if workspace["monitor"] != destination:
            moves.append("hl.dispatch(hl.dsp.workspace.move({workspace=" +
                         lua(workspace_selector(name)) + ",monitor=" + lua(destination) + "}))")
    if moves:
        evaluate(";".join(moves))
    if only_laptop:
        focus_workspace(snapshot["focused_workspace"])
        evaluate("hl.dispatch(hl.dsp.focus({monitor=" + lua(internal_name) + "}))")
    else:
        focus_workspace(snapshot["active"][snapshot["internal"]])
        focus_workspace(snapshot["active"][snapshot["external"]])
        evaluate("hl.dispatch(hl.dsp.focus({monitor=" + lua(external_name) + "}))")
    errors = command("hyprctl", "configerrors").strip()
    if errors:
        raise RuntimeError(errors)


def notify(text, error=False):
    try:
        subprocess.run(["notify-send", "-a", "Мониторы", "-i", "video-display",
                        "-u", "critical" if error else "normal", "Мониторы", text],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        pass


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--laptop", action="store_true")
    group.add_argument("--restore", action="store_true")
    group.add_argument("--status", action="store_true")
    args = parser.parse_args()
    if args.status:
        print(json.dumps({"laptop_only": laptop_mode(), "monitors": [
            {"name": m["name"], "focused": m["focused"], "refresh": m["refreshRate"]}
            for m in query("monitors")
        ]}))
        return
    with (directory / "lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        target = args.laptop or (not args.restore and not laptop_mode())
        if target and not laptop_mode():
            external, internal = detect(query("monitors", "all"))
            if external.get("disabled"):
                raise RuntimeError("Нет активного внешнего монитора для сохранения раскладки.")
            snapshot = capture(external, internal)
            atomic_write(snapshot_file, json.dumps(snapshot, indent=2))
        else:
            if not snapshot_file.exists():
                if not target:
                    return
                raise RuntimeError("Нет сохранённой раскладки.")
            snapshot = json.loads(snapshot_file.read_text())
        try:
            apply(target, snapshot)
        except Exception:
            # Always try to return both screens if a transition fails.
            try:
                apply(False, snapshot)
            except Exception:
                mode_file.unlink(missing_ok=True)
                subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=10)
            raise
        # XWayland has its own primary output, independent of Hyprland focus.
        try:
            subprocess.run([str(Path.home() / ".local/bin/set-xwayland-primary")],
                           capture_output=True, timeout=8, check=False)
        except (OSError, subprocess.TimeoutExpired):
            pass
        notify("Только экран ноутбука" if target else "Внешний монитор снова основной")
        print("laptop" if target else "dual")


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        notify(str(error), error=True)
        print(str(error), file=sys.stderr)
        sys.exit(1)
